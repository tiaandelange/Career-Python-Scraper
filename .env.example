# Copy this file to .env and fill in values locally.
# Never commit .env or real credentials.

# --- Supabase (required for persistence) ---
# Project URL from Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Service-role key. Backend / GitHub Actions only. Never expose to browsers.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: use the anon key only for read-only health probes if you add RLS policies.
# Do not use the anon key to write jobs.
SUPABASE_ANON_KEY=

# --- Resend (required only for the morning digest) ---
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender, e.g. Job Scout <jobs@yourdomain.com>
# For quick tests only: Job Scout <onboarding@resend.dev> (can only send to your Resend account email)
RESEND_FROM=Job Scout <onboarding@resend.dev>
# Recipient inbox for the daily digest
DIGEST_TO=you@example.com

# --- Optional official APIs (adapters stay disabled until keys exist) ---
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Adzuna developer API (free key). Disabled until both values are set.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Runtime ---
JOB_SCOUT_ENV=local
JOB_SCOUT_LOG_LEVEL=INFO
JOB_SCOUT_USER_AGENT=JobScout/1.0 (personal job search)
JOB_SCOUT_DRY_RUN=false
JOB_SCOUT_SEND_EMAIL=false
JOB_SCOUT_LIVE=false
JOB_SCOUT_CONFIG_DIR=config
